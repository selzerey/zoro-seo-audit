# zoro-seo-audit settings. Easiest: run "npx zoro-seo-audit setup" (writes ~/.config/zoro-seo-audit/.env).
# Or copy this file to ~/.config/zoro-seo-audit/.env (all projects) or ./.zoro-seo-audit.env (one project).
# Environment variables always win. Never commit real values. Only the keys of the services you use are needed.

# Google Search Console (either the three values or the two file paths)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_JSON=
GOOGLE_TOKEN_JSON=
GSC_SITE=sc-domain:example.com
# Brand words excluded from cannibalisation (comma separated)
GSC_BRAND=

# Bing Webmaster
BING_API_KEY=
BING_SITE=https://example.com/

# IndexNow
INDEXNOW_KEY=
INDEXNOW_HOST=example.com
INDEXNOW_KEY_LOCATION=

# Core Web Vitals field data (Chrome UX Report API key; scripts/cwv.mjs)
CRUX_API_KEY=

# Crawler user agent and report language (optional)
ZORO_UA=
ZORO_LANG=en

# stale-fact: file with old values (one entry per line "label: old1 | old2"), or inline entries split by ";"
ZORO_STALE_FILE=
ZORO_STALE_VALUES=
# placeholder-leak: exact shortcode names (comma separated, e.g. yil,site_adi)
ZORO_PLACEHOLDERS=
# link-dev-host: preview/staging hosts besides localhost (comma separated, e.g. vercel.app,preview.example.net)
ZORO_DEV_HOSTS=

# Private words the leak check must block (comma separated; or one per line in .leak-words)
ZORO_LEAK_WORDS=
