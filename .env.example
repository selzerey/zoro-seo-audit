# Copy to ~/.claude/skills/zoro-seo-audit/.env (global) or ./.claude/skills/zoro-seo-audit/.env (per project).
# process.env always wins. Never commit real values.

# Google Search Console (either the three values or the two file paths)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_JSON=
GOOGLE_TOKEN_JSON=
GSC_SITE=sc-domain:example.com
# Brand words excluded from cannibalisation (comma separated)
GSC_BRAND=

# Bing Webmaster
BING_API_KEY=
BING_SITE=https://example.com/

# IndexNow
INDEXNOW_KEY=
INDEXNOW_HOST=example.com
INDEXNOW_KEY_LOCATION=

# Crawler user agent (optional)
ZORO_UA=

# Private words the leak check must block (comma separated; or one per line in .leak-words)
ZORO_LEAK_WORDS=
